{
  "name": "grocery-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "proxy": "node proxy-server-local.js",
    "scraper:upload-cookies": "tsx scraper/scripts/upload-cookies.ts",
